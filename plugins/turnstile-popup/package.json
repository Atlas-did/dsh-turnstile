{
  "name": "turnstile-popup",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
  "compatibility": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "dshReleases": {
      "0.2.1-rc.3": "compatible",
      "0.2.1-rc.4": "unknown",
      "0.2.1-rc.5": "unknown",
      "0.2.2-alpha.2": "unknown"
    }
  },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}