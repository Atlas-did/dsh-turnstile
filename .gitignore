node_modules/

# fixtures deliberately contain fake node_modules trees — they are test data
!tests/**/node_modules/
!tests/**/node_modules/**
npm-debug.log*
pnpm-debug.log*
.DS_Store
*.log

# generated by the tools at runtime — never commit a machine's state
home/
state/
turnstile-state/
snapshots/
logs/
shots/

# local environment
.env
.env.*
!/.env.example
# fixtures may contain a fake DSH home — that is test data, not a real home
!tests/**/home/
!tests/**/home/**
*.e2e-backup
.bak-*

# runtime view state must never be committed inside a fixture
tests/**/.turnstile/turnstile-view.json

# the 2026-10-31 evidence corpus is frozen test data, not runtime logs
!tests/corpus/**/logs/
!tests/corpus/**/logs/**

# 运行产物：预览状态 / 启动器索引 / 流水账不应进仓库
tests/**/.turnstile/turnstile-journal.json
tests/**/.turnstile/launcher-index.json

# 写入备份与临时产物（由测试或手工 safeWritePatch 产生）
*.bak-[0-9]*
!docs/**
